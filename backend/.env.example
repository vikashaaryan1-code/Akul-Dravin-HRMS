# ═══════════════════════════════════════════════════════════════════════════════
# AKUL DRAVIN HRMS AI — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to source control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
HRMS_API_PORT=4100
HRMS_API_HOST=127.0.0.1

# ── Security (CRITICAL — MUST SET IN PRODUCTION) ──────────────────────────────
# Generate with: openssl rand -hex 64
HRMS_TOKEN_SECRET=CHANGE_ME_USE_openssl_rand_-hex_64
HRMS_TOKEN_TTL_SECONDS=14400

# ── Database — PostgreSQL ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://hrms_user:CHANGE_ME@localhost:5432/hrms_production
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000

# ── Redis (for sessions, rate-limiting, job queues) ───────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=CHANGE_ME

# ── AI Engine (FastAPI) ───────────────────────────────────────────────────────
AI_ENGINE_URL=http://localhost:8000
AI_ENGINE_API_KEY=CHANGE_ME

# ── Contact Webhook (optional) ────────────────────────────────────────────────
HRMS_CONTACT_WEBHOOK_URL=
HRMS_CONTACT_WEBHOOK_SECRET=CHANGE_ME
HRMS_CONTACT_WEBHOOK_TIMEOUT_MS=5000

# ── Email (SMTP / Transactional) ──────────────────────────────────────────────
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=noreply@akuldravin.com
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_NAME=Akul Dravin HRMS
SMTP_FROM_EMAIL=noreply@akuldravin.com

# ── Storage (S3-compatible for documents, exports) ────────────────────────────
S3_BUCKET=akul-dravin-hrms-documents
S3_REGION=ap-south-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_ENDPOINT=                    # Leave empty for AWS S3; set for MinIO/R2

# ── Monitoring & Observability ────────────────────────────────────────────────
SENTRY_DSN=                     # Optional: your Sentry project DSN
OTEL_EXPORTER_OTLP_ENDPOINT=   # Optional: OpenTelemetry collector endpoint
LOG_LEVEL=info                  # debug | info | warn | error

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_LOGIN_MAX=10

# ── OAuth Integrations (optional) ────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ── WhatsApp / SMS Notifications (optional) ──────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Biometric / Attendance Integration ───────────────────────────────────────
BIOMETRIC_WEBHOOK_SECRET=CHANGE_ME

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://hrms.akuldravin.com,https://app.akuldravin.com
