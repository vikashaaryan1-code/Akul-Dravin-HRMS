# ============================================================
# Akul Dravin HRMS — Backend Environment Variables
# Copy to .env and fill in values. Never commit .env to git.
# ============================================================

# ── Runtime ──────────────────────────────────────────────────
NODE_ENV=production
PORT=4001
WORKER_TYPE=all
SKIP_MICROSERVICES=true

# ── Database (Railway injects DATABASE_URL automatically) ────
# If DATABASE_URL is set, the individual vars below are ignored.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change_this
DB_NAME=akul_dravin_hrms

# ── Redis (Railway injects REDIS_URL automatically) ──────────
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 64
JWT_SECRET=change_this_for_production
JWT_EXPIRES_IN=12h

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://app.akuldravin.com

# ── Stripe Payments ──────────────────────────────────────────
# Live keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET=sk_live_...
# From Stripe Dashboard → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── AWS SES (Email Notifications) ────────────────────────────
AWS_REGION=ap-south-1
AWS_SES_REGION=ap-south-1
AWS_SES_FROM_EMAIL=noreply@akuldravin.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Notification Defaults ─────────────────────────────────────
PAYROLL_NOTIFY_EMAIL=hr@akuldravin.com
APP_URL=https://app.akuldravin.com

# ── MFA ─────────────────────────────────────────────────────
MFA_ISSUER=AkulDravinHRMS

# ── Internal Service Ports (dev only — ignored in production) ─
AUTH_SERVICE_PORT=4301
EMPLOYEE_SERVICE_PORT=4303
PAYROLL_SERVICE_PORT=4305
