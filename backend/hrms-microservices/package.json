{
  "name": "hrms-microservices",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS microservice backend architecture for Akul Dravin HRMS AI Super Platform",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:e2e": "jest --config jest.e2e.config.ts --runInBand",
    "seed": "ts-node src/database/seed.ts",
    "seed:fresh": "ts-node src/database/seed.ts --fresh",
    "db:harden": "ts-node src/database/harden-security.ts",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/datasource.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/datasource.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/datasource.ts migration:show",
    "governance:scan": "ts-node src/common/governance/scanner/governance-scanner.runner.ts --mode=ci --format=table",
    "governance:scan:json": "ts-node src/common/governance/scanner/governance-scanner.runner.ts --mode=ci --format=json",
    "governance:scan:sarif": "ts-node src/common/governance/scanner/governance-scanner.runner.ts --mode=ci --format=sarif",
    "governance:report": "ts-node src/common/governance/scanner/governance-scanner.runner.ts --mode=dashboard --format=table",
    "governance:baseline": "ts-node src/common/governance/scanner/governance-scanner.runner.ts --baseline"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bull": "^11.0.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/microservices": "^11.0.0",
    "@nestjs/passport": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/platform-socket.io": "^11.1.19",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.19",
    "@opentelemetry/auto-instrumentations-node": "^0.50.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@sentry/node": "^8.54.0",
    "@willsoto/nestjs-prometheus": "^6.0.2",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "bignumber.js": "^9.1.2",
    "bull": "^4.16.5",
    "bullmq": "^5.76.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.6",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "mathjs": "^15.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.25",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.2.0",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "@types/qrcode": "^1.5.5",
    "@types/sql.js": "^1.4.9",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "sql.js": "^1.12.0",
    "ts-jest": "^29.2.5",
    "ts-morph": "^23.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "brace-expansion@1.1.12": "1.1.13"
  }
}
