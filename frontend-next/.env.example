# ═══════════════════════════════════════════════════════════════════════════════
# AKUL DRAVIN HRMS AI — Frontend Environment Variables
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to source control.
# ═══════════════════════════════════════════════════════════════════════════════

# ── API Endpoints ─────────────────────────────────────────────────────────────
# Backend HRMS API (Node.js monolith)
NEXT_PUBLIC_API_BASE_URL=https://api.akuldravin.com

# ── App Metadata ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Akul Dravin HRMS AI
NEXT_PUBLIC_APP_URL=https://hrms.akuldravin.com

# ── AI Engine ─────────────────────────────────────────────────────────────────
# FastAPI AI engine URL (server-side only — do NOT prefix with NEXT_PUBLIC_)
AI_ENGINE_URL=http://ai-engine:8000

# ── Feature Flags ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_FEATURE_AI_HUB=true
NEXT_PUBLIC_FEATURE_GAMIFICATION=true
NEXT_PUBLIC_FEATURE_LMS=true
NEXT_PUBLIC_FEATURE_MARKETPLACE=false

# ── Logging ───────────────────────────────────────────────────────────────────
# debug | info | warn | error  (default: info)
NEXT_PUBLIC_LOG_LEVEL=info

# ── Analytics & Monitoring (optional) ────────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Auth (server-side only) ───────────────────────────────────────────────────
# Must match HRMS_TOKEN_SECRET in the backend .env
# NEXTAUTH_SECRET=CHANGE_ME_USE_openssl_rand_-hex_32
# NEXTAUTH_URL=https://hrms.akuldravin.com
