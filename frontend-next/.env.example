NEXT_PUBLIC_API_BASE_URL=https://api.akuldravin.com/api/v1

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Akul Dravin HRMS
NEXT_PUBLIC_APP_URL=https://app.akuldravin.com
